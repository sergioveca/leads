<?xml version="1.0" encoding="UTF-8"?>
<!--
  Safety net: only used if the site's document root is left at the project folder
  instead of the "public" folder. Blocks secrets/code and sends everything to public/.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment="src" />
          <add segment="storage" />
          <add segment="migrations" />
          <add segment="views" />
          <add segment="bin" />
          <add segment="data" />
          <add segment="tools" />
          <add segment="scripts" />
          <add segment="docs" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="Send to public" stopProcessing="true">
          <match url="^(?!public/)(.*)$" />
          <action type="Rewrite" url="public/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
