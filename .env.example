# Leads settings. Copy this file to ".env" in the same folder and fill in the values marked FILL.
# The .env file is never committed to Git and is not reachable from the web.

APP_DEBUG=false

# Database (Plesk > Databases). Host is usually localhost:3306.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=vecanetc_leads
DB_USERNAME=vecanetc_leads
DB_PASSWORD=FILL

# First admin login (created automatically on first visit; change later in Admin)
ADMIN_EMAIL=admin@vecanet.com
ADMIN_INITIAL_PASSWORD=FILL_your_password

# DealMachine (4Return's key; clients can add their own in Admin)
DEALMACHINE_API_KEY=FILL
DEALMACHINE_BASE_URL=https://api.v2.dealmachine.com/v1

# Long random strings (any letters/numbers, 32+ chars). Used for encryption and the
# machine endpoints /health?token=... and /cron?token=...
APP_KEY=FILL_random_32_plus_characters
HEALTH_TOKEN=FILL_random_32_plus_characters
CRON_TOKEN=FILL_random_32_plus_characters

# Scheduled task time budget (seconds) when run as "Run a PHP script"
CRON_BUDGET_SECONDS=240

# Home Detroit Podio ("New Podio Seller"). API key from podio.com/settings/api; signs in as this Podio user,
# so items show "<user> via 4Return Leads". Apps are "org/space/app" from the Podio URL (or numeric app ids).
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_USERNAME=
PODIO_PASSWORD=
#PODIO_SELLER_APP=detroitprogresscom/dpgr-crm/seller-leads
#PODIO_CONTACTS_APP=detroitprogresscom/dpgr-crm/contacts
#PODIO_LEAD_MANAGER=Tom ACQ
#PODIO_LEAD_SOURCE=4Return - County Leads APP
#PODIO_LEAD_STATUS=#New Untouched#

# sms.4-return.com read-only bridge (SMS thread for the Podio review page): same value as SMS_HISTORY_BRIDGE_TOKEN there
SMS_APP_URL=https://sms.4-return.com
SMS_HISTORY_BRIDGE_TOKEN=
