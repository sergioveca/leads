# Copy to .env on the server. NEVER commit real values.
APP_URL=https://leads.4-return.com
APP_TIMEZONE=America/Detroit

DB_HOST=localhost
DB_NAME=leads
DB_USER=leads
DB_PASS=

# Skip tracing (per-client keys are stored encrypted in the DB; this is 4Return's default)
DEALMACHINE_API_KEY=
DEALMACHINE_MONTHLY_CREDIT_CAP=15000
TRACERFY_API_KEY=            # optional, disabled when empty

# Compliance
CONTACT_WINDOW_START=09:00   # Michigan MCL 750.540e
CONTACT_WINDOW_END=21:00
DNC_RECHECK_DAYS=31
