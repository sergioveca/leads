APP_NAME=Leads
APP_ENV=production
APP_URL=https://leads.4-return.com
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=leads
DB_USERNAME=
DB_PASSWORD=

# DealMachine (4Return default key; clients can store their own in the app)
DEALMACHINE_API_KEY=
DEALMACHINE_BASE_URL=https://api.v2.dealmachine.com/v1
DEALMACHINE_MONTHLY_CREDIT_CAP=15000
DEALMACHINE_MIN_SCORE_TO_TRACE=50

# Mail (password resets / notifications)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=leads@4-return.com
